# the jack: on the speaker the output never passes its ceiling at full volume; headphones are louder
# the title (ZENITH-1, by Polystellarflow) first: a button during it only skips it
wait 4000
master 4096
wait 8000
peakreset
wait 30000
expect peak_db_max -16.3
expect peak_db_min -40
jack in
wait 3000
peakreset
wait 30000
expect peak_db_max -0.1
expect peak_db_min -14
jack out
wait 3000
peakreset
wait 20000
expect peak_db_max -16.3
